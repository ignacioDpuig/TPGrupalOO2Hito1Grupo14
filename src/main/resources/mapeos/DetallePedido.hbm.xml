<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.grupo14.datos.DetallePedido" table="detalle_pedido">
        
        <!-- Identificador compuesto por Pedido y Plato -->
        <composite-id>
            <key-many-to-one name="pedido" class="com.grupo14.datos.Pedido" column="id_pedido" lazy="false"/>
            <key-many-to-one name="plato" class="com.grupo14.datos.Plato" column="id_plato" lazy="false"/>
        </composite-id>

        <!-- Propiedad normal del detalle -->
        <property name="cantidad" column="cantidad" type="int"/>
        
    </class>
</hibernate-mapping>