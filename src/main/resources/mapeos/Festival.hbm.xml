<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.grupo14.datos.Festival" table="festival">
        <id name="id" column="id">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string"/>
        <property name="temporada" column="temporada" type="string"/>
        <property name="fechaInicio" column="fecha_inicio" />
        <property name="fechaFin" column="fecha_fin" />

        <set name="unidades" inverse="true" cascade="all-delete-orphan">
            <key column="id_festival"/>
            <one-to-many class="com.grupo14.datos.UnidadVenta"/>
        </set>
    </class>
</hibernate-mapping>