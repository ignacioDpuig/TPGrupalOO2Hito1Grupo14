<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.grupo14.datos.ConfiguracionCostos" table="configuracion_costos">
        <id name="id" column="id">
            <generator class="identity"/>
        </id>
        <property name="edadMinimaPersonal" column="edad_minima_personal" type="int"/>
        <property name="costoSuperficie" column="costo_superficie" type="double"/>
        <property name="costoMontaje" column="costo_montaje" type="double"/>
        <property name="plusElectricidad" column="plus_electricidad" type="double"/>
        <property name="plusAntiguedad" column="plus_antiguedad" type="double"/>
        <property name="sueldoBase" column="sueldo_base" type="double"/>
        <property name="plusCategoria" column="plus_categoria" type="double"/>
    </class>
</hibernate-mapping>
